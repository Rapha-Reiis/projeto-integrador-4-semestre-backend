NODE_ENV="development"
PORT=3000

#banco
DB_USER=usuario do banco
DB_PASSWORD=senha do banco
DB_HOST=localhost
DB_PORT=ex: 5433
DB_NAME=nome do database

#Funcionamento da API
SECRET_KEY=secret key 
BASE_URL=ex: localhost:3000
KAY_RAWG=colocar chave da rawg (só se GAME_PROVIDER=rawg)

#Jogos - IGDB (https://dev.twitch.tv/console/apps)
GAME_PROVIDER=igdb
TWITCH_CLIENT_ID=client id do app da twitch
TWITCH_CLIENT_SECRET=client secret do app da twitch


DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public
DATABASE_URL_TEST="file:./prisma/dev.db"
DIRECT_URL=url de conexão direta (usada pelas migrations)

#Supabase Storage - fotos de perfil (sem SUPABASE_SERVICE_KEY, salva no disco local)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=chave service_role (ou secret key) do projeto
SUPABASE_BUCKET=profile-images